                  minlength="10"
                  placeholder="Cuéntame sobre la oportunidad, proyecto o consulta..."
                  data-i18n-placeholder-es="Cuéntame sobre la oportunidad, proyecto o consulta..."
                  data-i18n-placeholder-en="Tell me about the role, project, or inquiry..."
                  class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-zinc-900 placeholder-zinc-400 transition focus:border-[#FF5A1F] focus:outline-none dark:border-[#333333] dark:bg-[#161616] dark:text-white"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full cursor-pointer rounded-lg bg-[#FF5A1F] py-2.5 font-bold text-white shadow-sm hover:bg-[#e04810] transition focus-visible:outline-2 focus-visible:outline-[#FF5A1F]"
              >
                <span data-i18n-es="Enviar Mensaje →" data-i18n-en="Send Message →">
                  Enviar Mensaje &rarr;
                </span>
              </button>

              <p
                id="form-feedback"
                role="status"
                aria-live="polite"
                class="hidden text-center text-xs font-semibold pt-1"
              ></p>
            </form>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-zinc-100 dark:border-[#222222] flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-zinc-500">
          <span
            data-i18n-es="🎓 INACAP (Ing. Informática)"
            data-i18n-en="🎓 INACAP (Computer Engineering)"
          >
            🎓 INACAP (Ing. Informática)
          </span>
          <span>·</span>
          <span
            data-i18n-es="💼 Entel Connect Center (4 años exp. TI)"
            data-i18n-en="💼 Entel Connect Center (4 yrs IT exp.)"
          >
            💼 Entel Connect Center (4 años exp. TI)
          </span>
          <span>·</span>
          <span
            data-i18n-es="🚀 Full Stack Python/Django & Frontend"
            data-i18n-en="🚀 Full Stack Python/Django & Frontend"
          >
            🚀 Full Stack Python/Django & Frontend
          </span>
        </div>
      </div>
    </div>
  </section>

  <script>
    // 1. Animación interactiva de los stacks en el titular naranja del Hero
    const typedEl = document.getElementById('hero-typed-stack');
    const stackPills = Array.from(document.querySelectorAll('.hero-stack-pill'));

    if (typedEl && stackPills.length > 0) {
      const phrases = stackPills.map(
        (btn) => btn.getAttribute('data-stack-phrase') || 'Python & Django.'
      );
      let currentIndex = 0;
      let charIndex = phrases[0].length;
      let isDeleting = false;
      let timerId = null;

      const highlightPill = (activeIdx) => {
        stackPills.forEach((pill, idx) => {
          if (idx === activeIdx) {
            pill.classList.add('!border-[#FF5A1F]', '!text-[#FF5A1F]', '!bg-[#FF5A1F]/10');
          } else {
            pill.classList.remove('!border-[#FF5A1F]', '!text-[#FF5A1F]', '!bg-[#FF5A1F]/10');
          }
        });
      };

      const step = () => {
        const currentPhrase = phrases[currentIndex];

        if (!isDeleting) {
          charIndex++;
          typedEl.textContent = currentPhrase.slice(0, charIndex);

          if (charIndex >= currentPhrase.length) {
            isDeleting = true;
            timerId = window.setTimeout(step, 2400);
            return;
          }
          timerId = window.setTimeout(step, 55);
        } else {
          charIndex--;
          typedEl.textContent = currentPhrase.slice(0, charIndex);

          if (charIndex <= 0) {
            isDeleting = false;
            currentIndex = (currentIndex + 1) % phrases.length;
            highlightPill(currentIndex);
            timerId = window.setTimeout(step, 260);
            return;
          }
          timerId = window.setTimeout(step, 28);
        }
      };

      highlightPill(0);
      timerId = window.setTimeout(() => {
        isDeleting = true;
        step();
      }, 2400);

      // Permitir hacer clic en cualquier píldora de stack para mostrarla al instante
      stackPills.forEach((pill, idx) => {
        pill.addEventListener('click', () => {
          if (timerId) window.clearTimeout(timerId);
          currentIndex = idx;
          isDeleting = false;
          charIndex = 0;
          typedEl.textContent = '';
          highlightPill(currentIndex);
          step();
        });
      });
    }

    // 2. Filtros interactivos de proyectos en JavaScript nativo (sin recargar la página)
    const filterButtons = Array.from(document.querySelectorAll('[data-project-filter]'));
    const projectCards = Array.from(document.querySelectorAll('[data-project-card]'));
    const filterCountEl = document.getElementById('project-filter-count');
    let activeFilter = 'all';

    const updateFilterCountText = (visibleCount, totalCount) => {
      if (!filterCountEl) return;
      const currentLang = document.documentElement.lang === 'en' ? 'en' : 'es';
      filterCountEl.textContent =
        currentLang === 'en'
          ? `Showing ${visibleCount} of ${totalCount} projects`
          : `Mostrando ${visibleCount} de ${totalCount} proyectos`;
    };

    const applyProjectFilter = (filterValue) => {
      activeFilter = filterValue;
      let visibleCount = 0;

      projectCards.forEach((card) => {
        const category = card.getAttribute('data-category');
        const status = card.getAttribute('data-status');
        const matches =
          filterValue === 'all' ||
          (filterValue === 'live' && status === 'live') ||
          category === filterValue;

        if (matches) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      filterButtons.forEach((btn) => {
        const isCurrent = btn.getAttribute('data-project-filter') === filterValue;
        btn.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');

        if (isCurrent) {
          btn.classList.add('border-[#FF5A1F]', 'bg-[#FF5A1F]', 'text-white');
          btn.classList.remove(
            'border-zinc-300',
            'bg-white',
            'text-zinc-700',
            'dark:border-[#2a2a2a]',
            'dark:bg-[#131313]',
            'dark:text-zinc-300'
          );
        } else {
          btn.classList.remove('border-[#FF5A1F]', 'bg-[#FF5A1F]', 'text-white');
          btn.classList.add(
            'border-zinc-300',
            'bg-white',
            'text-zinc-700',
            'dark:border-[#2a2a2a]',
            'dark:bg-[#131313]',
            'dark:text-zinc-300'
          );
        }
      });

      updateFilterCountText(visibleCount, projectCards.length);
    };

    if (filterButtons.length > 0 && projectCards.length > 0) {
      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selected = btn.getAttribute('data-project-filter') || 'all';
          applyProjectFilter(selected);
        });
      });

      window.addEventListener('portfolio:langchange', () => {
        applyProjectFilter(activeFilter);
      });
    }

    // 3. Validación interactiva y antispam del formulario de contacto
    const contactForm = document.getElementById('contact-form');
    const feedbackEl = document.getElementById('form-feedback');

    if (contactForm && feedbackEl) {
      contactForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const formData = new FormData(contactForm);
        const honeypot = String(formData.get('_gotcha') || '').trim();

        // Bloqueo silencioso si un bot llena el campo honeypot
        if (honeypot.length > 0) {
          return;
        }

        const name = String(formData.get('nombre') || '').trim();
        const email = String(formData.get('email') || '').trim();
        const message = String(formData.get('mensaje') || '').trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        const isEn = document.documentElement.lang === 'en';

        if (name.length < 2 || !emailRegex.test(email) || message.length < 10) {
          feedbackEl.textContent = isEn
            ? '⚠ Please complete your name, a valid email, and a message (min. 10 characters).'
            : '⚠ Por favor completa tu nombre, un correo válido y un mensaje (mín. 10 caracteres).';
          feedbackEl.className =
            'text-center text-xs font-semibold text-amber-600 dark:text-amber-400 pt-1';
          feedbackEl.classList.remove('hidden');
          return;
        }

        feedbackEl.textContent = isEn
          ? `✓ Thank you, ${name}! Your message has been registered. I will reply soon.`
          : `✓ ¡Gracias, ${name}! Tu mensaje quedó registrado. Te responderé lo antes posible.`;
        feedbackEl.className =
          'text-center text-xs font-semibold text-emerald-600 dark:text-emerald-400 pt-1';
        feedbackEl.classList.remove('hidden');
        contactForm.reset();
      });
    }
  </script>
</Layout>
