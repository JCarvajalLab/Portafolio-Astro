---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'Clínica Veterinaria Huellitas',
    badge: 'Completado v1.0.0',
    badgeClass: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300',
    description:
      'Landing page médica de alta conversión con portal clínico interactivo de agendamiento en 4 pasos, dark mode integral y 0 frameworks pesados.',
    tags: ['Astro 5', 'Tailwind v4', 'Vanilla JS', 'SSG'],
    demoUrl: 'https://huellitas-vet.pages.dev',
    repoUrl: 'https://github.com/JCarvajalLab/astro-landing-veterinaria',
    icon: '🐾',
  },
  {
    title: 'Portafolio con Casos de Estudio',
    badge: 'Fase 2 Activa',
    badgeClass: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300',
    description:
      'Plataforma profesional para documentar proyectos reales, con Content Collections de Astro, filtros dinámicos, SEO técnico y costo cero.',
    tags: ['Astro 5', 'Tailwind v4', 'Content Collections', 'SEO'],
    demoUrl: 'https://jcarvajallab.pages.dev',
    repoUrl: 'https://github.com/JCarvajalLab/Portafolio-Astro',
    icon: '💼',
  },
  {
    title: 'Ecommerce Tienda de Mascotas',
    badge: 'Próximo (Proyecto 3)',
    badgeClass: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300',
    description:
      'Comercio electrónico completo con catálogo de productos, carrito reactivo con JavaScript nativo, Astro SSR y pasarela de pago en sandbox.',
    tags: ['Astro SSR', 'Tailwind v4', 'Cart', 'Pagos'],
    demoUrl: '#',
    repoUrl: 'https://github.com/JCarvajalLab/astro-tienda-mascotas',
    icon: '🛒',
  },
];

const skills = [
  { name: 'Astro 5+', level: 'SSG & SSR sin frameworks pesados', category: 'Frameworks' },
  {
    name: 'Tailwind CSS v4',
    level: '@tailwindcss/vite, estilos modernos & Dark Mode',
    category: 'Estilos',
  },
  {
    name: 'JavaScript Moderno',
    level: 'ES6+, DOM nativo, módulos limpios sin dependencias',
    category: 'Lenguajes',
  },
  {
    name: 'Accesibilidad (a11y)',
    level: 'WCAG AA, navegación por teclado y aria tags',
    category: 'Calidad',
  },
  {
    name: 'SEO & Rendimiento',
    level: 'Lighthouse >= 90, Schema.org, Open Graph, Core Web Vitals',
    category: 'Optimización',
  },
  {
    name: 'Cloudflare Pages & Git',
    level: 'CI/CD automatizado, CDN global y costo $0 USD',
    category: 'Despliegue',
  },
];
---

<Layout title="JCarvajalLab | Desarrollador Web Frontend & Astro Specialist">
  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28">
    <!-- Efectos ambientales difuminados -->
    <div
      class="pointer-events-none absolute -top-40 left-1/2 -z-10 -translate-x-1/2 transform-gpu blur-3xl sm:-top-80"
      aria-hidden="true"
    >
      <div
        class="aspect-[1155/678] w-[68.4375rem] bg-gradient-to-tr from-indigo-500 to-purple-600 opacity-20 sm:w-[72.1875rem] dark:opacity-25"
        style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      ></div>
    </div>

    <div class="mx-auto max-w-5xl px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full px-3.5 py-1 text-xs font-semibold text-indigo-700 bg-indigo-50 border border-indigo-200/80 dark:bg-indigo-950/60 dark:text-indigo-300 dark:border-indigo-800/80 mb-6">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Disponible para desarrollo freelance & proyectos web</span>
      </div>

      <h1 class="text-4xl font-black tracking-tight sm:text-6xl text-slate-900 dark:text-white">
        Desarrollo Web Moderno,{' '}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-indigo-500 to-violet-500 dark:from-indigo-400 dark:to-violet-400">
          Rápido y Accesible
        </span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl leading-8 text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        Construyo aplicaciones web y sitios de alta conversión con{' '}
        <strong class="text-slate-900 dark:text-white">Astro 5</strong>,{' '}
        <strong class="text-slate-900 dark:text-white">Tailwind CSS v4</strong> y JavaScript nativo.
        Enfoque riguroso en rendimiento y código limpio.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="#proyectos"
          class="inline-flex items-center gap-2 rounded-full bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-md shadow-indigo-600/20 transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-indigo-600"
        >
          Explorar casos de estudio
          <span aria-hidden="true">&darr;</span>
        </a>

        <a
          href="#contacto"
          class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-indigo-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800/80"
        >
          Iniciar conversación
        </a>
      </div>
    </div>
  </section>

  <!-- CASOS DE ESTUDIO / PROYECTOS -->
  <section
    id="proyectos"
    class="scroll-mt-24 py-16 sm:py-20 border-t border-slate-200/60 dark:border-slate-800/60"
  >
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
            Portafolio Profesional
          </span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl text-slate-900 dark:text-white">
            Casos de Estudio & Proyectos
          </h2>
        </div>
        <p class="mt-3 md:mt-0 text-sm text-slate-600 dark:text-slate-400 max-w-md">
          Soluciones diseñadas de menor a mayor complejidad, aplicando las mejores prácticas de la
          industria con presupuesto de hosting $0 USD.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <article class="group relative flex flex-col justify-between rounded-3xl border border-slate-200/80 bg-white/80 p-6 backdrop-blur-sm shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-xl hover:border-indigo-300 dark:border-slate-800 dark:bg-slate-900/70 dark:hover:border-indigo-500/50">
            <div>
              <div class="flex items-center justify-between mb-5">
                <span class="text-3xl p-2 rounded-2xl bg-slate-50 dark:bg-slate-800/80 border border-slate-100 dark:border-slate-700/50">
                  {project.icon}
                </span>
                <span
                  class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${project.badgeClass}`}
                >
                  {project.badge}
                </span>
              </div>

              <h3 class="text-xl font-bold text-slate-900 group-hover:text-indigo-600 dark:text-white dark:group-hover:text-indigo-400 transition">
                {project.title}
              </h3>

              <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                {project.description}
              </p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="rounded-lg bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-semibold">
              {project.demoUrl !== '#' ? (
                <a
                  href={project.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 inline-flex items-center gap-1"
                >
                  Ver demo en vivo <span aria-hidden="true">&nearr;</span>
                </a>
              ) : (
                <span class="text-slate-400 dark:text-slate-500">En preparación</span>
              )}

              <a
                href={project.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white inline-flex items-center gap-1"
              >
                GitHub <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- STACK & HABILIDADES -->
  <section
    id="stack"
    class="scroll-mt-24 py-16 sm:py-20 bg-slate-100/50 dark:bg-slate-900/30 border-t border-slate-200/60 dark:border-slate-800/60"
  >
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
          Tecnologías & Estándares
        </span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl text-slate-900 dark:text-white">
          Stack Técnico & Buenas Prácticas
        </h2>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">
          Herramientas modernas elegidas bajo el principio de simplicidad, rendimiento nativo y cero
          costos de licencia o servidor.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {skills.map((item) => (
          <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/60">
            <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
              {item.category}
            </span>
            <h3 class="mt-1 text-base font-bold text-slate-900 dark:text-white">{item.name}</h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">{item.level}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SOBRE MÍ -->
  <section
    id="sobre-mi"
    class="scroll-mt-24 py-16 sm:py-20 border-t border-slate-200/60 dark:border-slate-800/60"
  >
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 items-center">
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative">
            <div class="h-64 w-64 rounded-3xl bg-gradient-to-tr from-indigo-600 to-violet-500 p-1 shadow-2xl">
              <div class="flex h-full w-full flex-col items-center justify-center rounded-[22px] bg-white p-6 text-center dark:bg-slate-950">
                <span class="text-5xl mb-3">👨‍💻</span>
                <span class="text-xl font-bold text-slate-900 dark:text-white">JCarvajalLab</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                  Desarrollador Web
                </span>
                <span class="mt-4 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 border border-emerald-200 dark:bg-emerald-950/50 dark:text-emerald-300 dark:border-emerald-800">
                  Astro · Tailwind · JS Nativo
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
            Filosofía de Trabajo
          </span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
            Soluciones simples, estables y bien optimizadas
          </h2>
          <p class="mt-4 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Creo en la web ligera y accesible. Si un problema se resuelve en 400 líneas en vez de
            1000, se hace en 400. Evito sobrecargar los bundles de usuario con frameworks
            innecesarios cuando las APIs nativas del navegador y el compilador de Astro logran una
            experiencia más rápida y confiable.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-slate-600 dark:text-slate-300">
            <li class="flex items-center gap-2.5">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 text-xs">
                ✓
              </span>
              <span>100% JavaScript nativo sin dependencias pesadas</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 text-xs">
                ✓
              </span>
              <span>Auditorías con Lighthouse superiores a 90 en todas las categorías</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 text-xs">
                ✓
              </span>
              <span>Arquitectura estática (SSG) de costo cero en Cloudflare Pages</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section
    id="contacto"
    class="scroll-mt-24 py-16 sm:py-20 bg-slate-900 text-white dark:bg-slate-950 border-t border-slate-800"
  >
    <div class="mx-auto max-w-4xl px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-500/10 px-3 py-1 text-xs font-semibold text-indigo-400 border border-indigo-500/20">
        ¿Tienes una propuesta o proyecto?
      </span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl text-white">
        Hablemos y Construyamos Algo Increíble
      </h2>
      <p class="mt-4 text-base text-slate-300 max-w-xl mx-auto">
        Disponible para proyectos freelance, colaboraciones o asesoría técnica en desarrollo
        frontend con Astro y Tailwind CSS.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="mailto:contacto@jcarvajallab.dev"
          class="inline-flex items-center gap-2 rounded-full bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/30 transition hover:bg-indigo-500"
        >
          Enviar un correo directo
          <span aria-hidden="true">&rarr;</span>
        </a>

        <a
          href="https://github.com/JCarvajalLab"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-800 px-6 py-3 text-sm font-semibold text-slate-200 transition hover:bg-slate-700"
        >
          Ver repositorio en GitHub
          <span aria-hidden="true">&nearr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
