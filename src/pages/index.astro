const skillCategories = [
  {
    number: '01',
    name: 'FRONTEND & UI',
    nameEn: 'FRONTEND & UI',
    items: [
      { name: 'ASTRO', icon: 'astro' },
      { name: 'VUE.JS', icon: 'vue' },
      { name: 'JAVASCRIPT', icon: 'js' },
