---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portafolio Profesional | Casos de Estudio">
  <div class="relative overflow-hidden py-24 sm:py-32">
    <!-- Efecto de gradiente de fondo -->
    <div
      class="pointer-events-none absolute -top-40 left-1/2 -z-10 -translate-x-1/2 transform-gpu blur-3xl sm:-top-80"
      aria-hidden="true"
    >
      <div
        class="aspect-[1155/678] w-[68.4375rem] bg-gradient-to-tr from-indigo-500 to-purple-600 opacity-20 sm:w-[72.1875rem] dark:opacity-25"
        style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      ></div>
    </div>

    <div class="mx-auto max-w-5xl px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full px-3.5 py-1 text-xs font-medium text-indigo-700 bg-indigo-50 border border-indigo-200/60 dark:bg-indigo-950/60 dark:text-indigo-300 dark:border-indigo-800/80 mb-6">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Fase 1: Setup Inicial Completado</span>
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight sm:text-6xl text-slate-900 dark:text-white">
        Portafolio &{' '}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-500 dark:from-indigo-400 dark:to-violet-400">
          Casos de Estudio
        </span>
      </h1>

      <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        Arquitectura moderna construida con{' '}
        <strong class="text-slate-900 dark:text-white">Astro</strong>,{' '}
        <strong class="text-slate-900 dark:text-white">Tailwind CSS v4</strong> y JavaScript nativo.
        Desarrollado con enfoque en rendimiento, accesibilidad y costo cero.
      </p>

      <!-- Grid de proyectos planeados -->
      <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 text-left">
        <!-- Tarjeta 1: Landing Veterinaria -->
        <div class="relative rounded-2xl border border-slate-200/80 bg-white/70 p-6 backdrop-blur-sm shadow-sm transition hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60">
          <div class="flex items-center justify-between mb-4">
            <span class="text-2xl">🐾</span>
            <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
              Completado v1.0.0
            </span>
          </div>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
            Clínica Veterinaria Huellitas
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Landing page médica de alta conversión con agendamiento clínico interactivo en 4 pasos,
            dark mode y 0 dependencias pesadas.
          </p>
          <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">
              Astro · Tailwind v4
            </span>
            <a
              href="https://huellitas-vet.pages.dev"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400"
            >
              Ver demo &rarr;
            </a>
          </div>
        </div>

        <!-- Tarjeta 2: Portafolio Actual -->
        <div class="relative rounded-2xl border-2 border-indigo-500/80 bg-white/90 p-6 backdrop-blur-sm shadow-md dark:border-indigo-500/70 dark:bg-slate-900/80">
          <div class="flex items-center justify-between mb-4">
            <span class="text-2xl">💼</span>
            <span class="rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-semibold text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">
              En progreso
            </span>
          </div>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
            Portafolio Profesional
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Casos de estudio detallados utilizando Content Collections de Astro, filtros dinámicos
            en JS nativo y SEO técnico completo.
          </p>
          <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">
              Content Collections
            </span>
            <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400">
              Fase 1 Activa
            </span>
          </div>
        </div>

        <!-- Tarjeta 3: Ecommerce Tienda de Mascotas -->
        <div class="relative rounded-2xl border border-slate-200/80 bg-white/70 p-6 backdrop-blur-sm shadow-sm transition hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60 sm:col-span-2 lg:col-span-1">
          <div class="flex items-center justify-between mb-4">
            <span class="text-2xl">🛒</span>
            <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
              Próximo
            </span>
          </div>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
            Tienda de Mascotas Ecommerce
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Catálogo de artículos, carrito interactivo con almacenamiento local, Astro SSR y
            pasarela de pago en modo sandbox.
          </p>
          <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">
              Astro SSR · Cart
            </span>
            <span class="text-xs text-slate-400">Proyecto 3</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
