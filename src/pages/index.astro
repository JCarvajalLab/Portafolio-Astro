---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const rawProjects = await getCollection('proyectos');
const projects = [...rawProjects].sort((a, b) => a.data.order - b.data.order);

const experienceList = [
  {
    role: 'Ejecutivo de asistencia técnica',
    company: 'Entel Connect Center',
    period: '2021 — Enero 2025',
    badge: 'Tiempo Completo · 4 Años',
    responsibilities: [
      'Gestión de incidencias técnicas mediante atención telefónica y canales digitales, orientando a usuarios y derivando casos para asegurar la continuidad del servicio.',
      'Uso de herramientas internas de soporte para análisis de problemas técnicos, registro de solicitudes y seguimiento de requerimientos.',
      'Atención de consultas técnicas por redes sociales y canales de contacto directo, entregando orientación y resolución oportuna.',
      'Aplicación diaria de habilidades de comunicación efectiva, pensamiento analítico y resolución metódica de problemas en un entorno de soporte crítico.',
    ],
  },
  {
    role: 'Práctica profesional en soporte mesa de servicio',
    company: 'Conytec Consultores SPA',
    period: '2018',
    badge: 'Práctica Profesional',
    responsibilities: [
      'Administración de cuentas de usuario en Active Directory (creación, modificación y anulación según solicitudes internas).',
      'Gestión de licencias y cuentas en Office 365 (habilitación, modificación y deshabilitación de usuarios).',
      'Elaboración de reportes semanales de actividades del área de soporte TI.',
      'Transferencia de archivos y despliegues desde servidores de QA hacia servidores de producción siguiendo procedimientos estandarizados.',
    ],
  },
];

const educationList = [
  {
    title: 'Desarrollo de Aplicaciones Full Stack Python Trainee',
    institution: 'Talento Digital para Chile',
    period: 'Feb. 2026 — Jul. 2026',
    type: 'Especialización Intensiva',
    detail:
      'Programa intensivo orientado a arquitectura y desarrollo de aplicaciones web Full Stack, integrando lógica de servidor, persistencia relacional y control de versiones colaborativo.',
    tags: ['Python', 'Django', 'PostgreSQL', 'JavaScript', 'Git & GitHub'],
  },
  {
    title: 'Desarrollo de Aplicaciones Front-End Trainee',
    institution: 'Talento Digital para Chile',
    period: 'Jul. 2024 — Ene. 2025',
    type: 'Especialización Intensiva',
    detail:
      'Formación práctica en construcción de interfaces web responsivas, componentes reactivos, consumo de APIs y maquetación semántica bajo estándares modernos.',
    tags: ['Vue.js', 'JavaScript ES6+', 'HTML5 & CSS3', 'Bootstrap', 'Git'],
  },
  {
    title: 'Ingeniería en Informática',
    institution: 'Universidad Tecnológica de Chile, INACAP',
    period: '2014 — 2018',
    type: 'Título Profesional Universitario',
    detail:
      'Formación integral en ingeniería de software, análisis y diseño de sistemas, modelado de bases de datos, administración de infraestructura y gestión de proyectos TI.',
    tags: [
      'Ingeniería de Software',
      'Bases de Datos',
      'Arquitectura de Sistemas',
      'Infraestructura TI',
    ],
  },
];

const skillCategories = [
  {
    number: '01',
    name: 'FRONTEND & UI',
    items: [
      { name: 'ASTRO', icon: 'astro' },
      { name: 'VUE.JS', icon: 'vue' },
      { name: 'JAVASCRIPT', icon: 'js' },
      { name: 'TAILWIND CSS', icon: 'tailwind' },
      { name: 'HTML5 & CSS3', icon: 'html' },
      { name: 'BOOTSTRAP', icon: 'bootstrap' },
    ],
  },
  {
    number: '02',
    name: 'BACKEND & BASES DE DATOS',
    items: [
      { name: 'PYTHON', icon: 'python' },
      { name: 'DJANGO', icon: 'django' },
      { name: 'POSTGRESQL', icon: 'postgres' },
      { name: 'SQL', icon: 'sql' },
    ],
  },
  {
    number: '03',
    name: 'SISTEMAS & INFRAESTRUCTURA',
    items: [
      { name: 'GIT & GITHUB', icon: 'git' },
      { name: 'ACTIVE DIRECTORY', icon: 'ad' },
      { name: 'MICROSOFT 365', icon: 'm365' },
      { name: 'CLOUDFLARE PAGES', icon: 'cloud' },
    ],
  },
];
---

<Layout title="Jordan Carvajal | Desarrollador Web & Ingeniero en Informática">
  <!-- HERO SECTION ESTILO EDITORIAL / ARQUITECTÓNICO CON PALETA 60-30-10 -->
  <section class="relative overflow-hidden py-20 sm:py-28 lg:py-32 border-b border-zinc-200 dark:border-[#222222]">
    <!-- Cuadrícula arquitectónica de fondo -->
    <div class="pointer-events-none absolute inset-0 -z-10 bg-hero-grid" aria-hidden="true"></div>

    <!-- Resplandor ambiental sutil -->
    <div
      class="pointer-events-none absolute -top-36 left-1/3 -z-10 h-[28rem] w-[28rem] rounded-full bg-[#FF5A1F]/10 blur-[120px]"
      aria-hidden="true"
    ></div>

    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Eyebrow superior técnico (estilo referencia) -->
      <div class="flex flex-wrap items-center gap-3 text-[11px] sm:text-xs font-mono uppercase tracking-[0.18em] mb-7">
        <span class="inline-flex items-center gap-2 font-bold text-[#0E0E0E] dark:text-white">
          <span class="h-2 w-2 rounded-full bg-[#FF5A1F] shadow-[0_0_10px_#FF5A1F] animate-pulse"></span>
          Disponible para oportunidades laborales
        </span>
        <span class="text-zinc-300 dark:text-zinc-700 select-none" aria-hidden="true">
          |
        </span>
        <span class="text-zinc-500 dark:text-zinc-400">
          Ingeniero en Informática · Desarrollo Web &amp; Soporte TI
        </span>
      </div>

      <!-- Titular gigante: Blanco + Naranja animado -->
      <h1 class="text-4xl sm:text-6xl lg:text-[4.75rem] font-extrabold tracking-tight leading-[1.06]">
        <span class="block text-[#0E0E0E] dark:text-white">Jordan Carvajal</span>
        <span class="block mt-1 sm:mt-2 text-[#FF5A1F]">Construyendo soluciones con</span>
        <span class="block text-[#FF5A1F] min-h-[1.15em]">
          <span id="hero-typed-stack">Python &amp; Django.</span>
          <span
            class="inline-block ml-1 font-light text-[#FF5A1F] animate-caret"
            aria-hidden="true"
          >
            |
          </span>
        </span>
      </h1>

      <!-- Barra visible de Stacks / Enfoque actual para lectura inmediata -->
      <div class="mt-8 flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mr-1">
          Stack &amp; Aprendizaje activo:
        </span>
        {[
          { label: 'Python & Django', phrase: 'Python & Django.' },
          { label: 'Astro & Tailwind CSS', phrase: 'Astro & Tailwind CSS.' },
          { label: 'JavaScript & Vue.js', phrase: 'JavaScript & Vue.js.' },
          { label: 'PostgreSQL & SQL', phrase: 'PostgreSQL & SQL.' },
          { label: 'Git & GitHub', phrase: 'Git, GitHub & Clean Code.' },
        ].map((item) => (
          <button
            type="button"
            data-stack-phrase={item.phrase}
            class="hero-stack-pill cursor-pointer rounded-full border border-zinc-300/80 bg-white/80 px-3.5 py-1 text-xs font-semibold text-zinc-700 transition hover:border-[#FF5A1F] hover:text-[#FF5A1F] dark:border-[#262626] dark:bg-[#141414]/90 dark:text-zinc-300 dark:hover:border-[#FF5A1F] dark:hover:text-[#FF5A1F]"
          >
            {item.label}
          </button>
        ))}
      </div>

      <!-- Línea divisoria horizontal a ancho completo (estilo referencia) -->
      <div class="my-10 border-t border-zinc-200 dark:border-white/10"></div>

      <!-- Fila inferior en dos columnas: Descripción a la izquierda + Botones píldora a la derecha -->
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-xl">
          Ingeniero en Informática (INACAP) desarrollando interfaces modernas y aplicaciones Full
          Stack. Combino código limpio en el frontend y backend con más de 4 años de experiencia
          resolviendo incidencias críticas en soporte TI corporativo, entregando soluciones claras,
          estables y enfocadas en las personas.
        </p>

        <!-- Botones tipo píldora (estilo referencia) -->
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href="#proyectos"
            class="inline-flex items-center gap-2.5 rounded-full bg-[#0E0E0E] px-7 py-3.5 text-sm font-bold text-white transition hover:bg-[#FF5A1F] dark:bg-white dark:text-[#0E0E0E] dark:hover:bg-[#FF5A1F] dark:hover:text-white focus-visible:outline-2 focus-visible:outline-[#FF5A1F]"
          >
            <span>Ver mi trabajo</span>
            <span aria-hidden="true">&rarr;</span>
          </a>

          <a
            href="https://www.linkedin.com/in/jcarvajallab/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Perfil de LinkedIn"
            title="LinkedIn"
            class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-zinc-300 bg-white text-[#0E0E0E] transition hover:border-[#FF5A1F] hover:text-[#FF5A1F] dark:border-white/15 dark:bg-[#141414] dark:text-white dark:hover:border-[#FF5A1F] dark:hover:text-[#FF5A1F]"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>

          <a
            href="https://github.com/JCarvajalLab"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Repositorios en GitHub"
            title="GitHub"
            class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-zinc-300 bg-white text-[#0E0E0E] transition hover:border-[#FF5A1F] hover:text-[#FF5A1F] dark:border-white/15 dark:bg-[#141414] dark:text-white dark:hover:border-[#FF5A1F] dark:hover:text-[#FF5A1F]"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 1. EXPERIENCIA PROFESIONAL EN TI -->
  <section
    id="experiencia"
    class="scroll-mt-20 py-16 sm:py-20 border-b border-zinc-200 dark:border-[#222222]"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#FF5A1F]">
            Trayectoria Laboral
          </span>
          <h2 class="mt-2 text-2xl sm:text-4xl font-extrabold tracking-tight text-[#0E0E0E] dark:text-white">
            Experiencia Profesional en TI
          </h2>
        </div>
        <p class="mt-2 md:mt-0 text-sm text-zinc-600 dark:text-zinc-400 max-w-md">
          Años de trabajo continuo en entornos corporativos de soporte, atención de incidencias
          críticas y resolución estructurada de problemas.
        </p>
      </div>

      <div class="space-y-6">
        {experienceList.map((job) => (
          <div class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-8 transition hover:border-[#FF5A1F] dark:border-[#262626] dark:bg-[#161616] dark:hover:border-[#FF5A1F]">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-zinc-100 pb-4 dark:border-[#222222]">
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-[#0E0E0E] dark:text-white">
                  {job.role}
                </h3>
                <p class="text-sm font-semibold text-[#FF5A1F]">{job.company}</p>
              </div>
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-zinc-100 px-3 py-1 text-xs font-semibold text-zinc-700 dark:bg-[#222222] dark:text-zinc-300">
                  {job.period}
                </span>
                <span class="rounded-full bg-[#FF5A1F]/10 px-3 py-1 text-xs font-bold text-[#FF5A1F] border border-[#FF5A1F]/30">
                  {job.badge}
                </span>
              </div>
            </div>

            <ul class="mt-4 space-y-2.5 text-sm text-zinc-600 dark:text-zinc-300">
              {job.responsibilities.map((task) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[#FF5A1F] mt-1 shrink-0 font-bold">▪</span>
                  <span>{task}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. FORMACIÓN ACADÉMICA (LÍNEA DE TIEMPO EDITORIAL ORDENADA) -->
  <section
    id="formacion"
    class="scroll-mt-20 py-20 sm:py-24 border-b border-zinc-200 dark:border-[#222222] bg-zinc-50/50 dark:bg-[#111111]/40"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-start">
        <!-- Columna Izquierda: Encabezado Editorial -->
        <div class="lg:col-span-4 lg:sticky lg:top-28">
          <span class="font-mono text-xs font-bold uppercase tracking-[0.22em] text-[#FF5A1F]">
            EDUCACIÓN &amp; ESPECIALIZACIÓN
          </span>
          <h2 class="mt-3 text-3xl sm:text-5xl font-black uppercase tracking-tight leading-[0.98] text-[#0E0E0E] dark:text-white">
            FORMACIÓN
            <br />
            <span class="text-[#FF5A1F]">ACADÉMICA</span>
          </h2>
          <p class="mt-5 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Base universitaria en Ingeniería en Informática complementada con especializaciones
            intensivas en desarrollo Full Stack y Frontend moderno, ordenadas de la más reciente a
            la más antigua.
          </p>
        </div>

        <!-- Columna Derecha: Línea de Tiempo Vertical con Tarjetas Horizontales Amplias -->
        <div class="lg:col-span-8">
          <div class="relative border-l-2 border-zinc-200 dark:border-[#262626] ml-3 sm:ml-4 pl-6 sm:pl-8 space-y-6">
            {educationList.map((edu, index) => (
              <div class="group relative rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7 transition hover:border-[#FF5A1F] dark:border-[#262626] dark:bg-[#161616] dark:hover:border-[#FF5A1F]">
                <!-- Nodo indicador en la línea de tiempo -->
                <span
                  class:list={[
                    'absolute -left-[31px] sm:-left-[39px] top-7 flex h-4 w-4 items-center justify-center rounded-full border-2 transition',
                    index === 0
                      ? 'border-[#FF5A1F] bg-[#FF5A1F] shadow-[0_0_12px_#FF5A1F]'
                      : 'border-zinc-300 bg-white group-hover:border-[#FF5A1F] dark:border-[#3a3a3a] dark:bg-[#0E0E0E] dark:group-hover:border-[#FF5A1F]',
                  ]}
                  aria-hidden="true"
                />

                <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-zinc-100 dark:border-[#222222]">
                  <span class="rounded-full bg-[#FF5A1F]/10 px-3 py-1 text-xs font-bold text-[#FF5A1F] border border-[#FF5A1F]/30">
                    {edu.type}
                  </span>
                  <span class="rounded-full bg-zinc-100 px-3 py-1 font-mono text-xs font-semibold text-zinc-700 dark:bg-[#222222] dark:text-zinc-300">
                    {edu.period}
                  </span>
                </div>

                <h3 class="mt-4 text-lg sm:text-xl font-bold text-[#0E0E0E] dark:text-white">
                  {edu.title}
                </h3>
                <p class="mt-1 text-sm font-semibold text-[#FF5A1F]">{edu.institution}</p>
                <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
                  {edu.detail}
                </p>

                <div class="mt-4 flex flex-wrap gap-1.5">
                  {edu.tags.map((tag) => (
                    <span class="rounded-md border border-zinc-200 bg-zinc-50 px-2.5 py-0.5 text-[11px] font-mono font-medium text-zinc-600 dark:border-[#2a2a2a] dark:bg-[#111111] dark:text-zinc-400">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. COMPETENCIAS TÉCNICAS & STACK (ESTILO TOOLKIT CON ICONOS A COLOR) -->
  <section
    id="competencias"
    class="scroll-mt-20 py-20 sm:py-24 border-b border-zinc-200 dark:border-[#222222]"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-start">
        <!-- Columna Izquierda: Título Editorial Toolkit -->
        <div class="lg:col-span-4 lg:sticky lg:top-28">
          <span class="font-mono text-xs font-bold uppercase tracking-[0.22em] text-zinc-500 dark:text-zinc-400">
            TOOLKIT
          </span>
          <h2 class="mt-3 text-4xl sm:text-5xl font-black uppercase tracking-tight leading-[0.95] text-[#0E0E0E] dark:text-white">
            SKILLS &amp;
            <br />
            <span class="text-[#FF5A1F]">EXPERTISE</span>
          </h2>
          <p class="mt-5 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Una selección curada de frameworks, lenguajes y tecnologías en las que me enfoco para
            construir aplicaciones web robustas, rápidas y mantenibles.
          </p>
        </div>

        <!-- Columna Derecha: Categorías Numeradas con Bloques de Iconos Oficiales a Color -->
        <div class="lg:col-span-8 space-y-12">
          {skillCategories.map((cat) => (
            <div>
              <div class="border-b border-zinc-200 pb-3 mb-5 dark:border-[#262626]">
                <h3 class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400">
                  <span class="text-[#FF5A1F]">{cat.number}.</span> {cat.name}
                </h3>
              </div>

              <div class="flex flex-wrap gap-3">
                {cat.items.map((skill) => (
                  <div class="group inline-flex items-center gap-3 border border-zinc-300 bg-white px-4 py-3 text-xs font-mono font-bold uppercase tracking-wider text-[#0E0E0E] transition hover:border-[#FF5A1F] hover:bg-[#FF5A1F]/10 dark:border-[#2a2a2a] dark:bg-[#161616] dark:text-white dark:hover:border-[#FF5A1F] dark:hover:bg-[#FF5A1F]/10">
                    <span class="flex h-5 w-5 items-center justify-center shrink-0 transition-transform group-hover:scale-110">
                      {skill.icon === 'astro' && (
                        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
                          <path fill="#FF5D01" d="M12 2L3 19h4.6l4.4-9.8L16.4 19H21L12 2z" />
                          <path
                            fill="#FF1639"
                            d="M12 15.2c-1.9 0-3.2 1.2-3.2 2.8 0 1.3 1 2.4 2.3 2.7-.2-.5-.2-1.2.2-1.7.4-.5 1.2-.6 1.7-.2.5.4.6 1.2.2 1.7-.1.1-.2.2-.3.2 1.4-.3 2.3-1.4 2.3-2.7 0-1.6-1.3-2.8-3.2-2.8z"
                          />
                        </svg>
                      )}
                      {skill.icon === 'vue' && (
                        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
                          <path fill="#41B883" d="M2 3h4l6 10.4L18 3h4L12 20.4 2 3z" />
                          <path fill="#35495E" d="M6 3h3.6L12 7.2 14.4 3H18l-6 10.4L6 3z" />
                        </svg>
                      )}
                      {skill.icon === 'js' && (
                        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
                          <rect width="20" height="20" x="2" y="2" rx="2.5" fill="#F7DF1E" />
                          <path
                            fill="#000000"
                            d="M12.7 16.5c0 1.8-1.1 2.6-2.6 2.6-1.4 0-2.2-.7-2.6-1.6l1.4-.8c.3.5.6.9 1.2.9.6 0 1-.2 1-1.1v-5.8h1.6v5.8zm4.8 2.6c-1.6 0-2.7-.8-3.2-1.9l1.4-.8c.4.6.9 1.1 1.8 1.1.8 0 1.3-.4 1.3-.9 0-.6-.5-.9-1.4-1.3l-.5-.2c-1.4-.6-2.3-1.3-2.3-2.9 0-1.4 1.1-2.5 2.8-2.5 1.2 0 2.1.4 2.7 1.5l-1.4.9c-.3-.6-.7-.8-1.3-.8-.6 0-1 .4-1 .8 0 .6.4.8 1.2 1.2l.5.2c1.6.7 2.5 1.4 2.5 3 0 1.7-1.3 2.6-3.1 2.6z"
                          />
                        </svg>
