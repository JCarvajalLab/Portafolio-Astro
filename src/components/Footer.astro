---
// src/components/Footer.astro
// Pie de página editorial moderno con paleta 60-30-10 e iconos de redes a color

const currentYear = new Date().getFullYear();

const navFooter = [
  { href: '/#experiencia', labelEs: 'Experiencia TI', labelEn: 'IT Experience' },
  { href: '/#formacion', labelEs: 'Formación Académica', labelEn: 'Education' },
  { href: '/#competencias', labelEs: 'Competencias Técnicas', labelEn: 'Tech Stack' },
  { href: '/#proyectos', labelEs: 'Proyectos & Lab', labelEn: 'Projects & Lab' },
  { href: '/#contacto', labelEs: 'Contacto Directo', labelEn: 'Direct Contact' },
];
---

<footer class="relative overflow-hidden border-t border-zinc-200 bg-white dark:border-[#222222] dark:bg-[#0B0B0B]">
  <!-- Resplandor ambiental sutil en el borde superior del Footer -->
  <div
    class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-48 w-[36rem] -translate-x-1/2 rounded-full bg-[#FF5A1F]/10 blur-[110px]"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6 lg:px-8">
    <!-- Grilla Principal del Footer -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 pb-12 border-b border-zinc-200 dark:border-[#222222]">
      <!-- Columna 1: Marca, Propuesta de Valor y Estado (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
        <div>
          <a
            href="/"
            class="inline-flex items-center gap-2.5 font-extrabold text-xl tracking-tight text-[#0E0E0E] dark:text-white group"
          >
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#FF5A1F] text-white font-mono font-black text-xs shadow-[0_0_16px_rgba(255,90,31,0.4)] transition-transform group-hover:scale-105">
              &#123; &#125;
            </span>
            <span>
              JCarvajal<span class="text-[#FF5A1F]">Lab</span>
            </span>
          </a>

          <p
            data-i18n-es="Ingeniero en Informática (INACAP). Con más de 4 años de trayectoria en soporte TI corporativo y hoy enfocado en el desarrollo web Full Stack y Frontend a través de proyectos prácticos."
            data-i18n-en="Computer Engineer (INACAP). With 4+ years of corporate IT support experience and currently focused on Full Stack and Frontend web development through hands-on projects."
            class="mt-4 max-w-sm text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed"
          >
            Ingeniero en Informática (INACAP). Con más de 4 años de trayectoria en soporte TI
            corporativo y hoy enfocado en el desarrollo web Full Stack y Frontend a través de
            proyectos prácticos.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 font-mono text-[11px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
            <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_#10B981] animate-pulse"></span>
            <span
              data-i18n-es="Disponible para oportunidades TI"
              data-i18n-en="Available for IT opportunities"
            >
              Disponible para oportunidades TI
            </span>
          </span>
        </div>
      </div>

      <!-- Columna 2: Navegación Rápida (3 cols) -->
      <div class="lg:col-span-3">
        <h3
          data-i18n-es="01. EXPLORAR"
          data-i18n-en="01. EXPLORE"
          class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-[#FF5A1F]"
        >
          01. EXPLORAR
        </h3>
        <ul class="mt-5 space-y-3 text-sm font-medium">
          {navFooter.map((item) => (
            <li>
              <a
                href={item.href}
                class="group inline-flex items-center gap-2 text-zinc-600 hover:text-[#0E0E0E] dark:text-zinc-400 dark:hover:text-white transition-colors"
              >
                <span class="h-1 w-1 rounded-full bg-zinc-300 transition-all group-hover:w-2.5 group-hover:bg-[#FF5A1F] dark:bg-zinc-700" />
                <span data-i18n-es={item.labelEs} data-i18n-en={item.labelEn}>
                  {item.labelEs}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Redes y Canales Directos con Iconos a Color (4 cols) -->
      <div class="lg:col-span-4">
        <h3
          data-i18n-es="02. CONECTAR & REDES"
          data-i18n-en="02. CONNECT & SOCIAL"
          class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-[#FF5A1F]"
        >
          02. CONECTAR &amp; REDES
        </h3>

        <div class="mt-5 space-y-2.5">
          <!-- LinkedIn con icono oficial azul #0A66C2 -->
          <a
            href="https://www.linkedin.com/in/jcarvajallab/"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between rounded-xl border border-zinc-200 bg-zinc-50/80 p-3 transition hover:border-[#0A66C2] hover:bg-white dark:border-[#242424] dark:bg-[#141414] dark:hover:border-[#0A66C2] dark:hover:bg-[#181818]"
          >
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#0A66C2] text-white shadow-[0_0_12px_rgba(10,102,194,0.4)] transition-transform group-hover:scale-105">
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                </svg>
              </span>
              <div>
                <div class="text-xs font-bold text-[#0E0E0E] dark:text-white group-hover:text-[#0A66C2] dark:group-hover:text-[#3898EC] transition-colors">
                  LinkedIn
                </div>
                <div class="font-mono text-[11px] text-zinc-500 dark:text-zinc-400">
                  /in/jcarvajallab
                </div>
              </div>
            </div>
            <span class="font-mono text-xs font-bold text-[#0A66C2] dark:text-[#3898EC] transition-transform group-hover:translate-x-0.5">
              &nearr;
            </span>
          </a>

          <!-- GitHub con icono púrpura octocat #8B5CF6 -->
          <a
            href="https://github.com/JCarvajalLab"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between rounded-xl border border-zinc-200 bg-zinc-50/80 p-3 transition hover:border-[#8B5CF6] hover:bg-white dark:border-[#242424] dark:bg-[#141414] dark:hover:border-[#8B5CF6] dark:hover:bg-[#181818]"
          >
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-[#8B5CF6] to-[#6D28D9] text-white shadow-[0_0_12px_rgba(139,92,246,0.4)] transition-transform group-hover:scale-105">
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                    clip-rule="evenodd"
                  />
                </svg>
              </span>
              <div>
                <div class="text-xs font-bold text-[#0E0E0E] dark:text-white group-hover:text-[#8B5CF6] dark:group-hover:text-[#A78BFA] transition-colors">
                  GitHub
                </div>
                <div class="font-mono text-[11px] text-zinc-500 dark:text-zinc-400">
                  @JCarvajalLab
                </div>
              </div>
            </div>
            <span class="font-mono text-xs font-bold text-[#8B5CF6] dark:text-[#A78BFA] transition-transform group-hover:translate-x-0.5">
              &nearr;
            </span>
          </a>

          <!-- Formulario Directo con icono naranja #FF5A1F -->
          <a
            href="/#contacto"
            class="group flex items-center justify-between rounded-xl border border-zinc-200 bg-zinc-50/80 p-3 transition hover:border-[#FF5A1F] hover:bg-white dark:border-[#242424] dark:bg-[#141414] dark:hover:border-[#FF5A1F] dark:hover:bg-[#181818]"
          >
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#FF5A1F] text-white shadow-[0_0_12px_rgba(255,90,31,0.4)] transition-transform group-hover:scale-105">
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              </span>
              <div>
                <div
                  data-i18n-es="Formulario de Contacto"
                  data-i18n-en="Contact Form"
                  class="text-xs font-bold text-[#0E0E0E] dark:text-white group-hover:text-[#FF5A1F] transition-colors"
                >
                  Formulario de Contacto
                </div>
                <div
                  data-i18n-es="Mensaje directo en la web"
                  data-i18n-en="Direct message on site"
                  class="font-mono text-[11px] text-zinc-500 dark:text-zinc-400"
                >
                  Mensaje directo en la web
                </div>
              </div>
            </div>
            <span class="font-mono text-xs font-bold text-[#FF5A1F] transition-transform group-hover:translate-x-0.5">
              &rarr;
            </span>
          </a>
        </div>
      </div>
    </div>

    <!-- Barra Inferior Editorial + Botón VOLVER ARRIBA conservado -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 dark:text-zinc-400">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
        <span class="font-semibold text-[#0E0E0E] dark:text-white">
          &copy; {currentYear} Jordan Carvajal
        </span>
        <span class="text-zinc-300 dark:text-zinc-700">·</span>
        <span
          data-i18n-es="Ingeniero en Informática & Desarrollador Web"
          data-i18n-en="Computer Engineer & Web Developer"
        >
          Ingeniero en Informática &amp; Desarrollador Web
        </span>
      </div>

      <div class="flex items-center gap-4">
        <span
          data-i18n-es="Construido con Astro 5 · Tailwind CSS v4"
          data-i18n-en="Built with Astro 5 · Tailwind CSS v4"
          class="hidden md:inline-block font-mono text-[11px]"
        >
          Construido con Astro 5 · Tailwind CSS v4
        </span>

        <a
          href="#"
          aria-label="Volver al inicio de la página"
          class="inline-flex items-center gap-2 border border-zinc-300 bg-white px-4 py-2 font-mono text-[11px] font-bold uppercase tracking-widest text-[#0E0E0E] transition hover:border-[#FF5A1F] hover:bg-[#FF5A1F] hover:text-white dark:border-[#2a2a2a] dark:bg-[#131313] dark:text-white dark:hover:border-[#FF5A1F] dark:hover:bg-[#FF5A1F]"
        >
          <span data-i18n-es="VOLVER ARRIBA" data-i18n-en="BACK TO TOP">
            VOLVER ARRIBA
          </span>
          <span aria-hidden="true">&uarr;</span>
        </a>
      </div>
    </div>
  </div>
</footer>
