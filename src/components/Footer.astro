---
// src/components/Footer.astro
// Pie de página profesional con paleta 60-30-10

const currentYear = new Date().getFullYear();

const navFooter = [
  { href: '/#experiencia', labelEs: 'Experiencia TI', labelEn: 'IT Experience' },
  { href: '/#formacion', labelEs: 'Formación Académica', labelEn: 'Education' },
  { href: '/#competencias', labelEs: 'Competencias Técnicas', labelEn: 'Tech Stack' },
  { href: '/#proyectos', labelEs: 'Proyectos & Lab', labelEn: 'Projects & Lab' },
  { href: '/#contacto', labelEs: 'Contacto Directo', labelEn: 'Direct Contact' },
];

const contactItems = [
  {
    labelEs: 'LinkedIn',
    labelEn: 'LinkedIn',
    href: 'https://www.linkedin.com/in/jcarvajallab/',
    ext: true,
  },
  {
    labelEs: 'GitHub',
    labelEn: 'GitHub',
    href: 'https://github.com/JCarvajalLab',
    ext: true,
  },
  {
    labelEs: 'Formulario de Contacto',
    labelEn: 'Contact Form',
    href: '/#contacto',
    ext: false,
  },
];
---

<footer class="border-t border-zinc-200 bg-white dark:border-[#222222] dark:bg-[#0E0E0E]">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
      <!-- Identidad y Perfil -->
      <div class="md:col-span-6 flex flex-col justify-between">
        <div>
          <a
            href="/"
            class="flex items-center gap-2.5 font-bold text-lg text-[#0E0E0E] dark:text-white"
          >
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[#FF5A1F] text-white font-mono font-black text-xs">
              &#123; &#125;
            </span>
            <span>
              JCarvajal<span class="text-[#FF5A1F]">Lab</span>
            </span>
          </a>
          <p
            data-i18n-es="Desarrollador Web Junior con orientación Frontend y proyección Full Stack. Ingeniero en Informática (INACAP), con experiencia profesional en soporte TI y resolución metódica de incidencias en Entel Connect Center."
            data-i18n-en="Junior Web Developer focused on Frontend and Full Stack growth. Computer Engineer (INACAP) with professional IT support experience and methodical incident resolution at Entel Connect Center."
            class="mt-3 max-w-md text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed"
          >
            Desarrollador Web Junior con orientación Frontend y proyección Full Stack. Ingeniero en
            Informática (INACAP), con experiencia profesional en soporte TI y resolución metódica de
            incidencias en Entel Connect Center.
          </p>
        </div>

        <div class="mt-6 flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-[#FF5A1F]/30 bg-[#FF5A1F]/10 px-3 py-1 text-xs font-semibold text-[#FF5A1F]">
            <span class="h-2 w-2 rounded-full bg-[#FF5A1F] animate-pulse"></span>
            <span
              data-i18n-es="Disponible para nuevas oportunidades laborales"
              data-i18n-en="Available for new job opportunities"
            >
              Disponible para nuevas oportunidades laborales
            </span>
          </span>
        </div>
      </div>

      <!-- Navegación -->
      <div class="md:col-span-3">
        <h3
          data-i18n-es="Secciones"
          data-i18n-en="Sections"
          class="text-xs font-bold uppercase tracking-wider text-[#0E0E0E] dark:text-white"
        >
          Secciones
        </h3>
        <ul class="mt-4 space-y-2 text-sm">
          {navFooter.map((item) => (
            <li>
              <a
                href={item.href}
                data-i18n-es={item.labelEs}
                data-i18n-en={item.labelEn}
                class="text-zinc-600 hover:text-[#FF5A1F] dark:text-zinc-400 dark:hover:text-[#FF5A1F] transition-colors"
              >
                {item.labelEs}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Conexión Directa -->
      <div class="md:col-span-3">
        <h3
          data-i18n-es="Contacto & Redes"
          data-i18n-en="Contact & Social"
          class="text-xs font-bold uppercase tracking-wider text-[#0E0E0E] dark:text-white"
        >
          Contacto & Redes
        </h3>
        <ul class="mt-4 space-y-2 text-sm">
          {contactItems.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.ext ? '_blank' : undefined}
                rel={item.ext ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center gap-1.5 text-zinc-600 hover:text-[#FF5A1F] dark:text-zinc-400 dark:hover:text-[#FF5A1F] transition-colors"
              >
                <span data-i18n-es={item.labelEs} data-i18n-en={item.labelEn}>
                  {item.labelEs}
                </span>
                {item.ext && <span class="text-xs opacity-60">&nearr;</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="mt-10 border-t border-zinc-200 pt-6 text-xs text-zinc-500 dark:border-[#222222] dark:text-zinc-400 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p>&copy; {currentYear} Jordan Carvajal.</p>
      <p
        data-i18n-es="Stack: Astro 5 · Tailwind CSS v4 · Despliegue en Cloudflare Pages"
        data-i18n-en="Stack: Astro 5 · Tailwind CSS v4 · Deployed on Cloudflare Pages"
        class="font-mono text-[11px]"
      >
        Stack: Astro 5 · Tailwind CSS v4 · Despliegue en Cloudflare Pages
      </p>
    </div>
  </div>
</footer>
