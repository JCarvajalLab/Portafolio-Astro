---
// src/components/Navbar.astro
// Barra de navegación moderna con paleta Negro #0E0E0E, Blanco #FFFFFF y Acento Naranja #FF5A1F

const navLinks = [
  { href: '/#experiencia', label: 'Experiencia' },
  { href: '/#formacion', label: 'Formación' },
  { href: '/#competencias', label: 'Competencias' },
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-zinc-200/80 bg-white/85 backdrop-blur-md dark:border-[#222222] dark:bg-[#0E0E0E]/85 transition-colors">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logotipo / Identidad JCarvajalLab con { } -->
    <a
      href="/"
      class="group flex items-center gap-2.5 font-bold tracking-tight text-[#0E0E0E] dark:text-white focus-visible:outline-2 focus-visible:outline-[#FF5A1F] rounded-lg"
      aria-label="JCarvajalLab - Inicio"
    >
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#FF5A1F] text-white font-mono font-black text-sm shadow-sm shadow-[#FF5A1F]/30 transition group-hover:scale-105">
        &#123; &#125;
      </span>
      <span class="text-base sm:text-lg font-extrabold tracking-tight">
        JCarvajal<span class="text-[#FF5A1F]">Lab</span>
      </span>
    </a>

    <!-- Enlaces de Escritorio -->
    <nav class="hidden md:flex items-center gap-6" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-xs font-semibold uppercase tracking-wider text-zinc-600 transition hover:text-[#FF5A1F] dark:text-zinc-300 dark:hover:text-[#FF5A1F]"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Acciones de Escritorio: Selector ES/EN + Toggle Dark Mode -->
    <div class="hidden items-center gap-2.5 md:flex">
      <!-- Botón Selector de Idioma ES / EN (Maquetado) -->
      <button
        type="button"
        class="inline-flex h-9 items-center justify-center rounded-lg border border-zinc-200 bg-zinc-100 px-2.5 font-mono text-xs font-bold text-zinc-700 transition hover:border-[#FF5A1F] hover:text-[#FF5A1F] dark:border-[#262626] dark:bg-[#161616] dark:text-zinc-300 dark:hover:border-[#FF5A1F] dark:hover:text-[#FF5A1F] cursor-pointer"
        title="Cambio de idioma (Fase futura)"
        aria-label="Alternar idioma español o inglés"
      >
        <span class="text-[#FF5A1F]">ES</span>
        <span class="text-zinc-400 dark:text-zinc-600 mx-1">/</span>
        <span class="text-zinc-500 dark:text-zinc-400">EN</span>
      </button>

      <!-- Toggle Dark Mode -->
      <button
        type="button"
        class="theme-toggle inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 bg-zinc-100 text-zinc-700 transition hover:border-[#FF5A1F] hover:text-[#FF5A1F] dark:border-[#262626] dark:bg-[#161616] dark:text-zinc-300 dark:hover:border-[#FF5A1F] dark:hover:text-[#FF5A1F] cursor-pointer"
        aria-label="Alternar modo oscuro y claro"
      >
        <!-- Icono Luna -->
        <svg
          class="h-4 w-4 block dark:hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
        <!-- Icono Sol -->
        <svg
          class="h-4 w-4 hidden dark:block text-[#FF5A1F]"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Controles para Dispositivos Móviles -->
    <div class="flex items-center gap-2 md:hidden">
      <!-- Selector ES/EN Móvil -->
      <button
        type="button"
        class="inline-flex h-9 items-center justify-center rounded-lg border border-zinc-200 bg-zinc-100 px-2 font-mono text-[11px] font-bold text-zinc-700 dark:border-[#262626] dark:bg-[#161616] dark:text-zinc-300 cursor-pointer"
        aria-label="Alternar idioma"
      >
        <span class="text-[#FF5A1F]">ES</span>
        <span class="text-zinc-400 mx-0.5">/</span>
        <span class="text-zinc-500">EN</span>
      </button>

      <!-- Toggle Dark Mode Móvil -->
      <button
        type="button"
        class="theme-toggle inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 bg-zinc-100 text-zinc-700 dark:border-[#262626] dark:bg-[#161616] dark:text-zinc-300 cursor-pointer"
        aria-label="Alternar modo oscuro y claro"
      >
        <svg
          class="h-4 w-4 block dark:hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
        <svg
          class="h-4 w-4 hidden dark:block text-[#FF5A1F]"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
      </button>

      <!-- Botón Menú Hamburguesa Móvil -->
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 bg-zinc-100 text-zinc-800 dark:border-[#262626] dark:bg-[#161616] dark:text-zinc-200 cursor-pointer"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <svg id="icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
        <svg
          id="icon-close"
          class="h-5 w-5 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú desplegable móvil -->
  <div
    id="mobile-menu"
    class="hidden border-b border-zinc-200 bg-white/95 px-4 py-4 backdrop-blur-md md:hidden dark:border-[#262626] dark:bg-[#0E0E0E]/95"
  >
    <nav class="flex flex-col gap-2" aria-label="Navegación móvil">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link flex items-center justify-between rounded-lg px-3 py-2 text-sm font-semibold text-zinc-700 hover:bg-zinc-100 hover:text-[#FF5A1F] dark:text-zinc-200 dark:hover:bg-[#161616] dark:hover:text-[#FF5A1F]"
        >
          <span>{link.label}</span>
          <span class="text-xs text-zinc-400">&rarr;</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // Menú móvil nativo
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isExpanded = toggleBtn?.getAttribute('aria-expanded') === 'true';
    toggleBtn?.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  }

  toggleBtn?.addEventListener('click', toggleMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
      toggleMenu();
      toggleBtn?.focus();
    }
  });

  // Dark Mode Toggle con persistencia
  const themeToggles = document.querySelectorAll('.theme-toggle');

  function toggleTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  }

  themeToggles.forEach((btn) => {
    btn.addEventListener('click', toggleTheme);
  });

  // Navegación limpia sin '#' residual en URL
  document.querySelectorAll('a[href*="/#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href') || '';
      const hashIndex = href.indexOf('#');
      if (hashIndex !== -1) {
        const targetId = href.substring(hashIndex + 1);
        const targetEl = document.getElementById(targetId);
        if (targetEl && (window.location.pathname === '/' || window.location.pathname === '')) {
          e.preventDefault();
          targetEl.scrollIntoView({ behavior: 'smooth' });
          history.replaceState(null, '', window.location.pathname);
        }
      }
    });
  });

  if (window.location.hash) {
    setTimeout(() => {
      history.replaceState(null, '', window.location.pathname);
    }, 300);
  }
</script>
